{
  "name": "@park/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean --noExternal @park/shared",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@colyseus/ws-transport": "^0.18.5",
    "@park/content": "workspace:*",
    "@park/shared": "workspace:*",
    "colyseus": "^0.18.12"
  }
}
